# Pré-produção local: não aponta para nenhum serviço Supabase Cloud.
ENVIRONMENT=test
INTEGRATION_TARGET=local
EMBEDDING_DIMENSIONS=1536

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from-supabase-status>
SUPABASE_SERVICE_KEY=<from-supabase-status>
SUPABASE_JWT_SECRET=<from-supabase-status>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Overrides usados somente dentro dos containers.
DOCKER_SUPABASE_URL=http://host.docker.internal:54321
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Isola o segundo stack Docker do stack publicado atual.
ENV_FILE=.env.staging-local
COMPOSE_PROJECT_NAME=radar-staging-local
APP_CONTAINER_NAME=radar-staging-app
WORKER_CONTAINER_NAME=radar-staging-worker
API_PORT=8001
DATA_DIR=./.data-staging
DISCOVERY_CRAWL4AI_ENABLED=0

# Use uma chave real apenas na máquina autorizada para gates conectados.
OPENAI_API_KEY=<local-secret>
ALERT_EMAIL_TO=
