# LLM
LLM_BACKEND=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# HYPER_EXTRACT_MODEL=gpt-4o-mini  # modelo do produtor de hipergrado. FIXO (não herda
#   OPENAI_MODEL): trocar o tier 3 não re-extrai (cache por source_hash). Só mude com
#   re-extração deliberada (deletar hypergraphs/ ou bump de versão de prompt).
# Anthropic (D1 híbrido: agentes em Sonnet 4.6, restante em OpenAI).
# Usado por core/agent_runtime.py quando provider="anthropic".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_AGENT=claude-sonnet-4-6
# Sprint 4 do Cenário B: idem para ProfileExtractor (endpoint público de onboarding).
AGENT_PROFILE_EXTRACTOR_DEFAULT_ENABLED=false
# ANTHROPIC_MODEL_AGENT_EXTRACTOR=claude-sonnet-4-6  # override do modelo do agente de extração de perfil
# EXTRACTOR_AGENT_MAX_STEPS=12                       # cap de iterações (fetch + list_links + lookup + submit)
# Resiliência das chamadas LLM (core/llm_client.py)
LLM_TIMEOUT_SECONDS=60            # corta requests penduradas; gerações longas ainda cabem
LLM_MAX_RETRIES=2                 # retries com backoff exponencial (nativo do SDK)

# ── Bake-off de modelos (docs/specs/llm-embedding-bakeoff.md) ──
# Cada ponto de LLM/embedding é trocável por env; troque só onde o eval verifica.
# Perfil demo/custo pronto p/ copiar: docs/specs/demo-cost-profile.md
# Embeddings (tier 1) — default canônico OpenAI text-embedding-3-small (1536d) desde 2026-06-26.
# small e large são ambos 1536d (mesma coluna vector(1536)); outro dim exige migração da coluna.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BASE_URL=                # endpoint OpenAI-compat (Ollama/vLLM); vazio = canônico
# EMBEDDING_API_KEY=                 # cai p/ OPENAI_API_KEY se vazio
# RETRIEVAL_EMBEDDING_COLUMN=embedding  # coluna do braço dense — FONTE ÚNICA ingest+query (default `embedding`)
# Contextualização do RAG (tier 2) — Gemini Flash-Lite empata gpt-4o-mini no gate (editais públicos).
# CONTEXTUAL_RETRIEVAL_MODEL=gpt-4o-mini
# CONTEXTUAL_RETRIEVAL_BASE_URL=     # ex.: https://generativelanguage.googleapis.com/v1beta/openai/
# CONTEXTUAL_RETRIEVAL_API_KEY=      # cai p/ OPENAI_API_KEY se vazio
# CONTEXTUAL_RETRIEVAL=true          # false = embeda texto cru (corta 1 chamada LLM/chunk no ingest)
# Raciocínio/extração (tiers 3-4) — LLM_BACKEND=gemini aponta match/extração ao Gemini.
# GEMINI_API_KEY=                    # AI Studio (free). Editais são públicos → OK; NÃO usar p/ writing.
# GEMINI_MODEL=gemini-2.5-flash      # modelo quando LLM_BACKEND=gemini (match/extração/structurer)
# Agêntico (tier 5) — capability p/ mirar endpoint OpenAI-compat (DeepSeek/ZDR). DADO DE CLIENTE:
# só provider ZDR/pago, NUNCA free-tier-com-treino. Não promover sem gate de grounding confiável.
# AGENT_OPENAI_BASE_URL=             # ex.: https://api.deepseek.com/v1 ; vazio = canônico OpenAI
# AGENT_OPENAI_API_KEY=              # cai p/ OPENAI_API_KEY se vazio
# CRITIC_OPENAI_BASE_URL=            # cai p/ AGENT_OPENAI_BASE_URL → canônico
# CRITIC_OPENAI_API_KEY=             # cai p/ AGENT_OPENAI_API_KEY → OPENAI_API_KEY
# OPENAI_MODEL_CRITIC=               # modelo do sub-agente critic (qualidade+compliance).
#   Fallback: OPENAI_MODEL_PRO → "gpt-4o-mini". Padrão é gpt-4o-mini (F3):
#   gpt-4o reduz falsos-positivos mas aumenta latência/custo ~5×. Medição em
#   docs/specs/writing-agent-evolution.md §5-F3: taxa de bloqueio ~10% (mini)
#   vs ~15% (4o) nas famílias 1-2 do golden, com menos falsos-positivos no 4o.

# ── Retrieval / RAG (core/retrieval/, core/reranker.py, core/kg/kg_store.py) ──
# RERANK_BACKEND=cross-encoder   # default; cross-encoder exige `pip install -e ".[rerank]"` (torch).
#                                # PROD sem torch: use `off` (RRF puro, ~400ms) ou `llm` (gpt-4o-mini, ~3s).
# KG_STORE_BACKEND=file          # default dev. PROD: `postgres` (KG na tabela kg_artifacts, não em arquivo).
# CATALOG_BACKEND=hypergraph     # default (v3 §8/§10, PR-A). `sql` lê `entities` (migration 036) —
#                                 # exige Supabase com o ingest (`core.kg.gold`) já rodado; NÃO ligar
#                                 # em prod até o remoto ter a migration + dado (flip é decisão de deploy).

# Telemetria de agentes (core/telemetry.py). Se vazias, telemetria é no-op.
# Obter em: cloud.langfuse.com → Project → Settings → API Keys.
# NUNCA colar chaves reais aqui — este arquivo é versionado; chaves vão no .env.
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://us.cloud.langfuse.com   # região do projeto (default: https://cloud.langfuse.com)

# Workspace sandbox p/ a suíte `writing` do eval (core/eval/writing.py) — cria
# sessões reais no Postgres, então precisa de um workspace dedicado (não um de
# usuário real). Crie um user via auth.admin.create_user + um row em
# `workspaces` referenciando o user_id, e cole o id do workspace aqui.
# EVAL_WORKSPACE_ID=

# Operador do sistema (CSV de e-mails). Gate das ferramentas de gestão —
# hoje a fila da Descoberta (/discovered-opportunities). Fail-closed: vazio =
# ninguém acessa. Decisão de produto 2026-07-03: Descoberta não é do cliente final.
# ADMIN_EMAILS=voce@exemplo.com

# CORS — origens do frontend permitidas (CSV). localhost já é liberado por padrão.
# Em produção: FRONTEND_URL=https://app.seudominio.com
FRONTEND_URL=

# Observabilidade (core/logging_config.py)
LOG_LEVEL=INFO                   # DEBUG/INFO/WARNING/ERROR
LOG_FORMAT=text                  # "json" em produção (p/ coletor), "text" em dev
# SENTRY_DSN=                    # se setado + `pip install sentry-sdk`, ativa Sentry
# ENV=production                 # ambiente reportado ao Sentry
# SENTRY_TRACES_SAMPLE_RATE=0.0  # 0.0–1.0 (performance tracing)

# Supabase — obter em: app.supabase.com → Project Settings → API
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...          # chave pública (usada no frontend)
SUPABASE_SERVICE_KEY=eyJ...       # chave privada (usada apenas no backend)
SUPABASE_JWT_SECRET=...           # em: Project Settings → API → JWT Secret

# For local development (supabase start), use:
#   SUPABASE_URL=http://localhost:54321
#   SUPABASE_ANON_KEY=<from `supabase status`>
#   SUPABASE_SERVICE_KEY=<from `supabase status`>
#   SUPABASE_JWT_SECRET=<from `supabase status`>

# Postgres DSN used by procrastinate worker (service-role connection).
# Local Supabase: see `supabase status` for the connection string.
# Production: use the Supabase Connection Pooler URL (Project Settings → Database → Connection pooling).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Alertas operacionais por e-mail (core/notify.py) — falhas dos crons do worker.
# Gmail: usar app password (myaccount.google.com → Security → App passwords).
# Sem USER/TO configurados, send_alert é no-op (dev não quebra).
# ALERT_SMTP_HOST=smtp.gmail.com   # default
# ALERT_SMTP_PORT=587              # default (STARTTLS)
# ALERT_SMTP_USER=                 # conta SMTP (Gmail: o próprio e-mail)
# ALERT_SMTP_PASSWORD=             # Gmail: app password, NÃO a senha da conta
# ALERT_EMAIL_FROM=                # default = ALERT_SMTP_USER
# ALERT_EMAIL_TO=                  # destinatário dos alertas

# Geração batch da proposta (hardening PR3): seções em paralelo via
# asyncio.gather + Semaphore. 4 é folgado p/ o TPM do gpt-4o-mini.
# GENERATION_CONCURRENCY=4

# Purge semanal dos checkpoints LangGraph (hardening PR6.1, task
# purge_agent_checkpoints): threads com último checkpoint mais antigo que isto
# são deletados do schema agent_memory. Cada turno é um thread que nunca é
# relido após o turno seguinte.
# CHECKPOINT_RETENTION_DAYS=30

# ── Memória auto-escrita (F6 — D3, writing-agent-evolution spec) ──
# AUTO_MEMORY_WRITE=0         # default OFF no pré-beta: toda escrita automática
#                             # em reflection_insights (SIGNAL na compressão,
#                             # reflect_workspace, synthesize_patterns) é NO-OP.
#                             # LEITURA de insights curados continua intacta
#                             # (load_active_insights, memory_search,
#                             # recall_company_learnings).
#                             # Religamento pós-beta: modelo "Cursor Memories"
#                             # — extração volta ativa, mas cada insight só é
#                             # injetado após aprovação humana (fila de
#                             # curadoria + TTL/decay). Spec futura — NÃO
#                             # implementado nesta versão.
