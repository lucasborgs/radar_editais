ENVIRONMENT=production
SUPABASE_URL=https://<production-project-ref>.supabase.co
SUPABASE_ANON_KEY=<secret-manager>
SUPABASE_SERVICE_KEY=<secret-manager>
SUPABASE_JWT_SECRET=<secret-manager>
DATABASE_URL=postgresql://<production-pooler-from-secret-manager>
OPENAI_API_KEY=<secret-manager>
# Opt-ins de mutação não devem permanecer ligados no serviço.
ALLOW_PRODUCTION_MUTATION=0
CONFIRM_PROJECT_REF=
